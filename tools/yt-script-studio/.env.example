# 이 파일을 복사해서 .env 로 이름을 바꾸고 키를 넣으세요. (.env는 Git에 올라가지 않습니다)

# YouTube Data API v3 키 (무료) — README "키 발급" 참고
YOUTUBE_API_KEY=

# Claude API 키 — https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# (선택) 사용할 Claude 모델. 기본: claude-opus-5-5 / 절약: claude-sonnet-5-5
# CLAUDE_MODEL=claude-opus-5-5

# (선택) 포트. 기본 7788
# PORT=7788

# (휴대폰·VM에서 쓸 때 필수) 접속 비밀번호. 설정하면 열 때 아이디/비밀번호를 묻습니다 (아이디는 아무거나)
# APP_PASSWORD=
